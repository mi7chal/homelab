{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "ignorePaths": [
    "**/*.enc.yaml",
    "**/*.secret.yaml"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "flux": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["/fluxcd/"],
      "groupName": "flux"
    },
    {
      "description": "Auto-merge non-major app updates after 3 days",
      "matchFileNames": ["k8s/apps/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Keep Authentik updates manual",
      "matchFileNames": ["k8s/apps/authentik/**"],
      "automerge": false
    }
  ]
}
