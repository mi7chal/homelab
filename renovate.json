{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "ignorePaths": [
    "**/*.enc.yaml",
    "**/*.secret.yaml"
  ],
  "flux": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["/fluxcd/"],
      "groupName": "flux"
    }
  ]
}
